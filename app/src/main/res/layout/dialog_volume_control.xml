<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <Button
        android:id="@+id/runSystemTestButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test 30 km/h" />

    <Button
        android:id="@+id/runFullAudioTestButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Test Alle Audios" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Indicator Lautstärke"
        android:textStyle="bold"
        android:textSize="16sp" />

    <SeekBar
        android:id="@+id/indicatorVolumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Hintergrund Lautstärke"
        android:textStyle="bold"
        android:textSize="16sp" />

    <SeekBar
        android:id="@+id/backgroundVolumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100" />

    <TextView
        android:id="@+id/volumeWarning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Warnung: Hohe Lautstärke kann das Gehör schädigen!"
        android:textColor="#FF0000"
        android:visibility="gone" />

</LinearLayout>